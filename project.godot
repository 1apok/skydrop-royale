; Engine configuration file.
config_version=5

[application]

config/name="SKYDROP Royale"
config/description="Offline battle royale with building and zero-build modes."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon/icon.png"
boot_splash/bg_color=Color(0.05, 0.06, 0.12, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
global_illumination/sdfgi/probe_ray_count=1
global_illumination/sdfgi/frames_to_converge=2
global_illumination/sdfgi/frames_to_update_light=2
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=48
environment/ssao/quality=1
environment/ssil/quality=1
anti_aliasing/screen_space_roughness_limiter/enabled=true
occlusion_culling/use_occlusion_culling=false
